                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.64">
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" From="6"
                                                                         To="44" Duration="0:0:0.65" AutoReverse="True" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Rectangle.Triggers>
                                    </Rectangle>
                                    <Rectangle Grid.Column="9" Fill="#2EA043" VerticalAlignment="Bottom" Height="6"
                                               Margin="2,0">
                                        <Rectangle.Triggers>
                                            <EventTrigger RoutedEvent="Rectangle.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.72">
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" From="6"
                                                                         To="44" Duration="0:0:0.65" AutoReverse="True" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Rectangle.Triggers>
                                    </Rectangle>
                                    <Rectangle Grid.Column="10" Fill="#238636" VerticalAlignment="Bottom" Height="6"
                                               Margin="2,0">
                                        <Rectangle.Triggers>
                                            <EventTrigger RoutedEvent="Rectangle.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.80">
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" From="6"
                                                                         To="44" Duration="0:0:0.65" AutoReverse="True" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Rectangle.Triggers>
                                    </Rectangle>
                                    <Rectangle Grid.Column="11" Fill="#1A6B32" VerticalAlignment="Bottom" Height="6"
                                               Margin="2,0">
                                        <Rectangle.Triggers>
                                            <EventTrigger RoutedEvent="Rectangle.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.88">
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" From="6"
                                                                         To="44" Duration="0:0:0.65" AutoReverse="True" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Rectangle.Triggers>
                                    </Rectangle>
                                    <Rectangle Grid.Column="12" Fill="#145A29" VerticalAlignment="Bottom" Height="6"
                                               Margin="2,0">
                                        <Rectangle.Triggers>
                                            <EventTrigger RoutedEvent="Rectangle.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.96">
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" From="6"
                                                                         To="44" Duration="0:0:0.65" AutoReverse="True" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Rectangle.Triggers>
                                    </Rectangle>
                                    <Rectangle Grid.Column="13" Fill="#0D4F1C" VerticalAlignment="Bottom" Height="6"
                                               Margin="2,0">
                                        <Rectangle.Triggers>
                                            <EventTrigger RoutedEvent="Rectangle.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" BeginTime="0:0:1.04">
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" From="6"
                                                                         To="44" Duration="0:0:0.65" AutoReverse="True" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Rectangle.Triggers>
                                    </Rectangle>
                                </Grid>

                                <TextBlock x:Name="LoadingStatus" Text=""
                                           FontSize="14" FontWeight="Bold" Foreground="#C9D1D9"
                                           TextWrapping="NoWrap" TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Height="22" Margin="0,0,0,4" />
                                <TextBlock x:Name="LoadingDetail" Text=""
                                           FontSize="10" Foreground="#6E7681"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Height="36" LineHeight="18"
                                           Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#161B22" CornerRadius="4" Margin="0,0,4,0"
                                            Padding="10,7">
                                        <StackPanel>
                                            <TextBlock Text="FILES" FontSize="9" Foreground="#3FB950" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,2" />
                                            <TextBlock x:Name="LoadingFileCount" Text="—" FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="#C9D1D9" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#161B22" CornerRadius="4" Margin="4,0,4,0"
                                            Padding="10,7">
                                        <StackPanel>
                                            <TextBlock Text="RECORDS" FontSize="9" Foreground="#3FB950"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,2" />
                                            <TextBlock x:Name="LoadingRecordCount" Text="—" FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="#C9D1D9" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#161B22" CornerRadius="4" Margin="4,0,0,0"
                                            Padding="10,7">
                                        <StackPanel>
                                            <TextBlock Text="STATIONS" FontSize="9" Foreground="#3FB950"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,2" />
                                            <TextBlock x:Name="LoadingTypeCount" Text="—" FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="#C9D1D9" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ProgressBar x:Name="LoadingProgress" Height="4" Minimum="0" Maximum="100" Value="0"
                                             Margin="0,0,0,4" Foreground="#3FB950" Background="#21262D" />
                                <Grid Height="26">
                                    <TextBlock x:Name="LoadingPercentage" Text="0%"
                                               FontSize="10" Foreground="#6E7681"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#1A5C35" Margin="0,16,0,16" />

                            <Grid Grid.Column="2" Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="LOADED STATIONS"
                                           FontSize="9" FontWeight="Bold" Foreground="#3FB950"
                                           Margin="14,12,0,6" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Margin="0,0,0,12">
                                    <ItemsControl x:Name="LoadingStationLog" Margin="8,0,8,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding StatusIcon}"
                                                               FontSize="9"
                                                               Foreground="{Binding IconColor}"
                                                               VerticalAlignment="Top"
                                                               Margin="0,1,0,0" />
                                                    <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                                        <TextBlock Text="{Binding Line1}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding Line1Color}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Line2}"
                                                                   FontSize="9"
                                                                   Foreground="#6E7681"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding Line2Visibility}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>