<Window x:Class="MESInsight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="MES Insight" WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="#0D1117"
        MinWidth="1024" MinHeight="600"
        FontFamily="pack://application:,,,/Fonts/#Inter 18pt">

    <Window.Resources>
        <Style x:Key="StatsHelpToolTipStyle" TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Rectangle Fill="#3FB950" RadiusX="5" RadiusY="5" Opacity="0.7" Width="10" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="12" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Grid Background="#0D1117" Width="10">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ThinScrollBarThumb}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Inter 18pt" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Inter 18pt" />
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CaretBrush" Value="#3FB950" />
            <Setter Property="SelectionBrush" Value="#1F4A2A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3FB950" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#238636" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Inter 18pt" />
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A2A21" />
                                <Setter Property="Foreground" Value="#C9D1D9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#24402F" />
                                <Setter Property="Foreground" Value="#E6EDF3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="{x:Type Button}"
               BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Foreground" Value="#E05252" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A1F24" />
                                <Setter Property="Foreground" Value="#FFB3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#5B2730" />
                                <Setter Property="Foreground" Value="#FFD2D6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopBarActionBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14261D" />
                    <Setter Property="BorderBrush" Value="#284233" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Inter 18pt" />
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Inter 18pt" />
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="#0D1117" />
            <Setter Property="BorderBrush" Value="#21262D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Inter 18pt" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6E7681" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid Margin="0,0,2,0">
                            <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Underline" Height="2" Background="Transparent" VerticalAlignment="Bottom"
                                    Margin="4,0,4,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Background" Value="#3FB950" />
                                <Setter Property="Foreground" Value="#E6EDF3" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C9D1D9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Inter 18pt" />
            <Setter Property="Background" Value="#0D1117" />
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="BorderBrush" Value="#21262D" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#21262D" />
            <Setter Property="RowBackground" Value="#0D1117" />
            <Setter Property="AlternatingRowBackground" Value="#161B22" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Inter 18pt" />
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="BorderBrush" Value="#21262D" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#161B22" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1C2A3A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Inter 18pt" />
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                    Background="#161B22" BorderBrush="#30363D" BorderThickness="1.5"
                                    Margin="0,0,7,0" VerticalAlignment="Center">
                                <TextBlock x:Name="Check" Text="✓" FontSize="11" FontWeight="Bold"
                                           Foreground="#3FB950" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#3FB950" />
                                <Setter TargetName="Box" Property="Background" Value="#0D2818" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#3FB950" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AllTabStyle" TargetType="{x:Type TabItem}">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Inter 18pt" />
            <Setter Property="Foreground" Value="#D18616" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid Margin="0,0,2,0">
                            <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Underline" Height="2" Background="Transparent" VerticalAlignment="Bottom"
                                    Margin="4,0,4,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Background" Value="#F78166" />
                                <Setter Property="Foreground" Value="#FFA657" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFA657" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AssemblyTabStyle" TargetType="{x:Type TabItem}">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Inter 18pt" />
            <Setter Property="Foreground" Value="#388BFD" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid Margin="0,0,2,0">
                            <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Underline" Height="2" Background="Transparent" VerticalAlignment="Bottom"
                                    Margin="4,0,4,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Background" Value="#58A6FF" />
                                <Setter Property="Foreground" Value="#79C0FF" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#79C0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="#D18616" CornerRadius="5" Opacity="0.85" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Grid Background="#0D1117">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True" Width="10">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SidebarScrollBarThumbStyle}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                       Style="{StaticResource SidebarScrollBarStyle}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="#0D1117" BorderBrush="#1A3A20" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Width="4" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent"
                    Cursor="SizeWE" Panel.ZIndex="999" Grid.RowSpan="3" MouseLeftButtonDown="ResizeLeft_Down" />
            <Border Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent"
                    Cursor="SizeWE" Panel.ZIndex="999" Grid.RowSpan="3" MouseLeftButtonDown="ResizeRight_Down" />
            <Border Height="4" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="Transparent"
                    Cursor="SizeNS" Panel.ZIndex="999" MouseLeftButtonDown="ResizeTop_Down" />
            <Border Height="4" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="Transparent"
                    Cursor="SizeNS" Panel.ZIndex="999" Grid.Row="2" MouseLeftButtonDown="ResizeBottom_Down" />
            <Border Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                    Cursor="SizeNWSE" Panel.ZIndex="1000" MouseLeftButtonDown="ResizeTL_Down" />
            <Border Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent"
                    Cursor="SizeNESW" Panel.ZIndex="1000" MouseLeftButtonDown="ResizeTR_Down" />
            <Border Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent"
                    Cursor="SizeNESW" Panel.ZIndex="1000" Grid.Row="2" MouseLeftButtonDown="ResizeBL_Down" />
            <Border Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="Transparent" Cursor="SizeNWSE" Panel.ZIndex="1000" Grid.Row="2"
                    MouseLeftButtonDown="ResizeBR_Down" />

            <Grid Grid.Row="0" Background="#0A1F12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="⏱" FontSize="14" Foreground="#3FB950" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="🗠  MES Insight"
                               FontSize="13" FontWeight="Light"
                               Foreground="#E6EDF3"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="TxtStationName"
                           Text=""
                           FontSize="11"
                           Foreground="#6E7681"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">

                    <!-- Report Bug -->
                    <Border x:Name="ReportBugButton" Cursor="Hand" Padding="10,0" Height="36"
                            Style="{StaticResource TopBarActionBorderStyle}"
                            ToolTip="Report a bug or issue">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ReportBugIcon" Text="🐛︎" FontSize="14"
                                       FontFamily="Segoe UI Symbol"
                                       Foreground="#C9D1D9" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock x:Name="ReportBugLabel" Text="Report Bug" FontSize="12"
                                       Foreground="#C9D1D9" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Border Width="1" Height="18" Background="#30363D" Margin="4,0" VerticalAlignment="Center"
                            Opacity="0.9" />

                    <!-- Track UID -->
                    <Border x:Name="TrackUidButton" Cursor="Hand" Padding="10,0" Height="36"
                            Style="{StaticResource TopBarActionBorderStyle}" ToolTip="Track UID (Ctrl+K)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TrackUidIcon" Text="⚲" FontSize="15"
                                       Foreground="#C9D1D9" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock x:Name="TrackUidLabel" Text="Track UID" FontSize="12"
                                       Foreground="#C9D1D9" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Expand TextBox -->
                    <Border x:Name="TrackUidInputHost" Width="0" Height="26" Margin="0,0,4,0"
                            Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                            CornerRadius="4" ClipToBounds="True" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSubsetUid" FontFamily="Consolas" FontSize="11"
                                     Background="Transparent" Foreground="#C9D1D9"
                                     BorderThickness="0" Padding="8,0,4,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="TxtSubsetUid_KeyDown" />
                            <TextBlock Grid.Column="1" Text="✕" FontSize="10" Cursor="Hand"
                                       x:Name="TrackUidClose" Foreground="#6E7681"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       MouseLeftButtonUp="TrackUidClose_Click" />
                        </Grid>
                    </Border>

                    <!-- Separator -->
                    <Border Width="1" Height="18" Background="#30363D" Margin="4,0" VerticalAlignment="Center"
                            Opacity="0.9" />

                    <!-- New Session -->
                    <Border x:Name="NewSessionButton" Cursor="Hand" Padding="10,0" Height="36"
                            Style="{StaticResource TopBarActionBorderStyle}"
                            ToolTip="Start new session — clears all loaded data">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⇪" FontSize="15" Foreground="#C9D1D9"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="New Session" FontSize="12" Foreground="#C9D1D9"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Window controls -->
                    <Border Width="1" Height="18" Background="#30363D" Margin="8,0,4,0" VerticalAlignment="Center"
                            Opacity="0.9" />
                    <Button Width="40" Height="40" Style="{StaticResource TitleBarButtonStyle}" FontSize="18"
                            Cursor="Hand" Click="BtnMinimize_Click" ToolTip="Minimize">
                        &#x2014;
                    </Button>
                    <Button x:Name="BtnWinMaximize" Width="40" Height="40" Style="{StaticResource TitleBarButtonStyle}"
                            FontSize="18" Cursor="Hand" Click="BtnMaximize_Click" ToolTip="Maximize">
                        &#x25A1;
                    </Button>
                    <Button Width="40" Height="40" Style="{StaticResource TitleBarCloseButtonStyle}" FontSize="14"
                            Cursor="Hand" Click="BtnClose_Click" ToolTip="Close">
                        &#x2715;
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#071810"
                    BorderBrush="#0D3020" BorderThickness="0,1,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="StationDropdownHost" Grid.Column="0" />
                    <ContentControl x:Name="BtnScrollLeftHost" Grid.Column="1" />
                    <ScrollViewer x:Name="StationBarScrollViewer"
                                  Grid.Column="2"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  Padding="0,4,0,4">
                        <StackPanel x:Name="StationBarPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center" />
                    </ScrollViewer>
                    <ContentControl x:Name="BtnScrollRightHost" Grid.Column="3" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="8" Background="#0D1117">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="*" />
