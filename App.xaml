<Application x:Class="MESInsight.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <DrawingGroup x:Key="MesAppIconDrawing">
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="#1E1E1E" Thickness="12" StartLineCap="Round" EndLineCap="Round" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <LineGeometry StartPoint="40,440" EndPoint="460,440" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>

            <GeometryDrawing Brush="#75A87B">
                <GeometryDrawing.Pen>
                    <Pen Brush="#1E1E1E" Thickness="10" LineJoin="Round" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="75,320,54,120" RadiusX="6" RadiusY="6" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>

            <GeometryDrawing Brush="#5D9B65">
                <GeometryDrawing.Pen>
                    <Pen Brush="#1E1E1E" Thickness="10" LineJoin="Round" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="149,220,54,220" RadiusX="6" RadiusY="6" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>

            <GeometryDrawing Brush="#448E4D">
                <GeometryDrawing.Pen>
                    <Pen Brush="#1E1E1E" Thickness="10" LineJoin="Round" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="223,270,54,170" RadiusX="6" RadiusY="6" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>

            <GeometryDrawing Brush="#36753D">
                <GeometryDrawing.Pen>
                    <Pen Brush="#1E1E1E" Thickness="10" LineJoin="Round" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="297,170,54,270" RadiusX="6" RadiusY="6" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>

            <GeometryDrawing Brush="#275C2C">
                <GeometryDrawing.Pen>
                    <Pen Brush="#1E1E1E" Thickness="10" LineJoin="Round" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="371,110,54,330" RadiusX="6" RadiusY="6" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>

            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="#1E1E1E" Thickness="42" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M40,260 L160,140 L230,190 L370,50" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>

            <GeometryDrawing Brush="#1E1E1E">
                <GeometryDrawing.Pen>
                    <Pen Brush="#1E1E1E" Thickness="12" LineJoin="Round" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M430,-10 L405,85 L335,15 Z" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>

            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Brush="#D9701E" Thickness="26" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M40,260 L160,140 L230,190 L370,50" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>

            <GeometryDrawing Brush="#D9701E">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M430,-10 L405,85 L335,15 Z" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingGroup>

        <DrawingImage x:Key="MesAppIcon" Drawing="{StaticResource MesAppIconDrawing}" />
        <DrawingImage x:Key="MesAppIconSmall" Drawing="{StaticResource MesAppIconDrawing}" />
        <FontFamily x:Key="InterFont">pack://application:,,,/Fonts/#Inter 18pt</FontFamily>
        <FontFamily x:Key="InterThin">pack://application:,,,/Fonts/#Inter 18pt Thin</FontFamily>
        <FontFamily x:Key="InterLight">pack://application:,,,/Fonts/#Inter 18pt Light</FontFamily>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        </Style>
        <Style TargetType="Window">
            <Setter Property="Icon" Value="{StaticResource MesAppIcon}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
        </Style>

        <Style x:Key="MesScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#32823C"
                                CornerRadius="4"
                                Margin="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="#08160C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <Track Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MesScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MesRangeSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#3FB950" Stroke="#0A1F0F" StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#3FB950" BlurRadius="10" ShadowDepth="0" Opacity="0.55" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MesRangeSlider" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="3"
                                    Background="#12331A"
                                    CornerRadius="1.5"
                                    VerticalAlignment="Center" />
                            <Border x:Name="PART_FillTrack"
                                    Height="3"
                                    Background="#3FB950"
                                    CornerRadius="1.5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Width="0" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MesRangeSliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>